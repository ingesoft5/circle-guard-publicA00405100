<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.icesi</groupId>
    <artifactId>studytrack-api</artifactId>
    <!--
        Versión base de release (maven-releases no acepta -SNAPSHOT).
        En el pipeline se reemplaza por una versión inmutable:
            1.0.0-<BUILD_NUMBER>-<hash corto del commit>
        mediante: mvn versions:set -DnewVersion=...
    -->
    <version>1.0.0</version>
    <name>studytrack-api</name>
    <description>Backend REST de StudyTrack (Taller Evaluativo 2 - Ingeniería de Software V)</description>

    <properties>
        <java.version>17</java.version>
        <!-- URL base de Nexus. Desde el host: localhost:9081.
             Desde Jenkins (red cicd_network) se sobrescribe con -Dnexus.url=http://nexus:8081 -->
        <nexus.url>http://localhost:9081</nexus.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>studytrack-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!--
        ============================================================
        Fase 2 - Publicación Inmutable en Nexus.
        El <id> debe coincidir con el <server> de ci-settings.xml, que toma
        usuario/clave de variables de entorno (inyectadas por Jenkins desde
        la credencial "nexus-credentials"), nunca en texto plano.
        ============================================================
    -->
    <distributionManagement>
        <repository>
            <id>nexus-releases</id>
            <name>Nexus maven-releases</name>
            <url>${nexus.url}/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

</project>
